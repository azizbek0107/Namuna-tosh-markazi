# Copy to .env.local. Keep these server-side; never add a VITE_ prefix.
OPENAI_API_KEY=
# Use a Responses API model available to your OpenAI project.
OPENAI_MODEL=

# Vercel Storage -> Upstash Redis. Keep these server-side (no VITE_ prefix).
# KV_REST_API_URL / KV_REST_API_TOKEN are also supported.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional override; defaults to a separate key for Production and Preview.
REDIS_STATE_KEY=
