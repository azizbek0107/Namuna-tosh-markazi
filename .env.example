# ==============================================================================
# NAMUNA TOSH MARKAZI — ATROF-MUHIT SOZLAMALARI (PRODUCTION .env.example)
# ==============================================================================
# Ushbu fayldan nusxa olib, haqiqiy ma'lumotlar bilan .env yoki .env.local yarating.
# DIQQAT: Hech qachon shaxsiy/maxfiy kalitlarni git tizimiga yuklamang!

# ------------------------------------------------------------------------------
# 1. SUPABASE AUTH & STORAGE (Bosqich 9 & 10)
# ------------------------------------------------------------------------------
# Supabase boshqaruv panelidan olingan URL va ANON/PUBLISHABLE kaliti
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Muqobil nom (Vite tavsiya etgan publishable kalit formati):
VITE_SUPABASE_PUBLISHABLE_KEY=

# ------------------------------------------------------------------------------
# 2. STONEX ERP API INTEGRATSIYASI (Bosqich 11)
# ------------------------------------------------------------------------------
# StoneX ERP boshqaruv serverining asosiy API manzili (HTTPS bo'lishi shart)
# Masalan: https://erp.namunatosh.uz yoki https://api.stonex.uz
VITE_STONEX_ERP_API_URL=

# Ochiq katalog so'rovlari uchun mijoz kaliti (agar ERP tomonidan talab etilsa)
# DIQQAT: Hech qachon administrator yoki maxfiy maxsus kalitlarni bu yerga yozmang!
VITE_STONEX_ERP_PUBLIC_KEY=

# ------------------------------------------------------------------------------
# 3. SAYT ASOSIY MA'LUMOTLARI VA TELEGRAM
# ------------------------------------------------------------------------------
# Veb-saytning jonli asosiy domeni (SEO canonical va sitemap uchun)
VITE_SITE_URL=https://namunatosh.uz

# Rasmiy Telegram buyurtma qabul qiluvchi menejer username'i
VITE_TELEGRAM_USERNAME=aura_200707
